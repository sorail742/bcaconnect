{
  "name": "bcaconnect",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first node src/index.js",
    "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first nodemon src/index.js",
    "migrate": "node scripts/run-migrations.js",
    "test:api": "node test-api.js",
    "test:rotation": "node test-refresh-rotation.js",
    "test:validation": "node test-global-validation.js",
    "test": "jest --runInBand --forceExit",
    "test:security": "jest tests/auth.test.js tests/escrow.test.js tests/disputes.test.js tests/payment-hmac.test.js tests/orders.test.js --runInBand --forceExit",
    "test:phase1": "jest tests/orders.test.js tests/auth.test.js tests/escrow.test.js --runInBand --forceExit",
    "test:phase2": "npm run test:security && node scripts/test-group-purchases.js",
    "verify:postgres": "node scripts/verify-postgres.js",
    "test:payment": "node scripts/test-cinetpay-staging.js",
    "test:payment:check": "node scripts/test-cinetpay-staging.js --check-env",
    "redis:monitor": "node redis-monitor.js monitor",
    "redis:watch": "node redis-monitor.js watch 3000",
    "redis:clear": "node redis-monitor.js clear",
    "seed:technician": "node scripts/seed-technician-demo.js",
    "seed:group-purchases": "node scripts/seed-group-purchases.js",
    "seed:pending-credits": "node scripts/seed-pending-credits.js",
    "seed:carrier-demo": "node scripts/seed-carrier-demo.js",
    "seed:guarantees": "node scripts/seed-guarantees.js",
    "seed:catalog": "node scripts/seed-catalog-images.js",
    "seed:suppliers": "node scripts/seed-suppliers.js",
    "restore:stock": "node scripts/restore-product-stock.js",
    "seed:accounts": "node scripts/create-test-accounts.js",
    "seed:recharge-wallets": "node scripts/seed-recharge-wallets.js",
    "seed:education": "node scripts/seed-education.js",
    "seed:categories": "node scripts/seed-categories.js",
    "security:audit": "npm audit --audit-level=high",
    "security:snyk": "snyk test --severity-threshold=high"
  },
  "keywords": [],
