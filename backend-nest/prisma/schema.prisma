// Schéma Prisma — ne modélise que les tables déjà reprises par un module
// NestJS migré (cf. plan de migration progressive, cahier des charges
// "backend totalement NestJS"). Toute autre table reste possédée par
// Sequelize côté backend/ tant que son module n'a pas basculé : ne pas
// ajouter de modèle ici sans faire le cutover correspondant dans
// backend/src/app.js + supprimer le modèle Sequelize équivalent.
//
// Modèles obtenus par introspection réelle (`prisma db pull`) de la base
// partagée avec Sequelize — jamais recopiés à la main depuis les fichiers
// backend/src/**/models/*.model.js.
//
// created_at/updated_at sont mappés en createdAt/updatedAt (@map) : c'est
// le nom que Sequelize expose réellement côté JSON (timestamps automatiques
// non affectés par `underscored: true`, qui ne renomme que la colonne SQL,
// jamais l'attribut JS) — sans ce mapping, tout consommateur frontend qui
// lit `.createdAt` recevrait `undefined`.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Module pilote (Phase 1) — table "webinaires", zéro association entrante
// ou sortante avec une autre table (vérifié dans backend/src/models/index.js
// avant de choisir ce module comme pilote).
model webinaires {
  id                 String                  @id @db.Uuid
  titre              String                  @db.VarChar(255)
  description        String
  date_heure         DateTime                @db.Timestamptz(6)
  intervenant        String                  @db.VarChar(255)
  categorie          String?                 @db.VarChar(255)
  statut             enum_webinaires_statut? @default(a_venir)
  participants_count Int?                    @default(0)
  lien_rejoindre     String?                 @db.VarChar(255)
  video_url          String?                 @db.VarChar(255)
  createdAt          DateTime                @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @map("updated_at") @db.Timestamptz(6)
}

enum enum_webinaires_statut {
  a_venir
  en_direct
  termine
}

// Phase 2, module 1/3 — table "categories". Référencée par des tables
// encore côté Sequelize (produits.categorie_id, demandes_devis.categorie_id,
// et le self-lien parent_id) — vérifié directement en base (pg_constraint) :
// les 3 contraintes sont ON DELETE SET NULL, jamais RESTRICT. Supprimer une
// catégorie qui a encore des produits/sous-catégories/demandes de devis
// rattachés réussit toujours ; ces lignes se retrouvent juste avec un
// categorie_id/parent_id à NULL. category.service.ts garde malgré tout une
// interception générique de P2003 (bonne pratique défensive sur un endpoint
// de suppression), mais elle ne devrait jamais se déclencher pour ce cas
// précis.
model categories {
  id              String       @id @db.Uuid
  nom_categorie   String       @unique @db.VarChar(50)
  description     String?
  parent_id       String?      @db.Uuid
  statut          String?      @default("actif") @db.VarChar(20)
  image_url       String?      @db.VarChar(255)
  createdAt       DateTime     @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @map("updated_at") @db.Timestamptz(6)
  parent          categories?  @relation("sousCategories", fields: [parent_id], references: [id])
  sous_categories categories[] @relation("sousCategories")
  produits        produits[]
}

// Phase 2, module 2/3 — "BCA Academy" (educational_resources/quizzes/
// progress, cahier des charges 3.14). Seule association entrante depuis un
// module encore Sequelize : educational_progress.utilisateur_id -> User
// (onDelete: Cascade) — l'alias Sequelize `progression_academy` déclaré
// dans models/index.js n'est utilisé par aucun `include` dans le reste du
// code (vérifié par recherche), donc aucun risque de lecture cassée côté
// Express à retirer ce modèle. educational_quizzes/progress référencent
// educational_resources en Cascade également (supprimer une ressource
// supprime son quiz et toute la progression liée — comportement Postgres
// réel, pas une simplification introduite ici).
model educational_resources {
  id                    String                                     @id @db.Uuid
  titre                 String                                     @db.VarChar(255)
  description           String
  type_contenu          enum_educational_resources_type_contenu?   @default(article)
  url_contenu           String                                     @db.VarChar(500)
  audience_cible        enum_educational_resources_audience_cible? @default(tous)
  tag                   String?                                    @db.VarChar(100)
  createdAt             DateTime                                   @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                                   @map("updated_at") @db.Timestamptz(6)
  educational_quizzes   educational_quizzes?
  educational_progress  educational_progress[]
}

enum enum_educational_resources_type_contenu {
  video
  article
  guide
  pdf
}

enum enum_educational_resources_audience_cible {
  tous
  fournisseurs
  clients
  transporteurs
}

model educational_quizzes {
  id                    String                @id @db.Uuid
  resource_id           String                @unique @db.Uuid
  questions             Json                  @default("[]") @db.Json
  passing_score         Int?                  @default(60)
  createdAt             DateTime              @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @map("updated_at") @db.Timestamptz(6)
  educational_resources educational_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)
}

model educational_progress {
  id                    String                @id @db.Uuid
  utilisateur_id        String                @db.Uuid
  resource_id           String                @db.Uuid
  statut                String?               @default("vu") @db.VarChar(20)
  quiz_score            Int?
  tentatives            Int?                  @default(0)
  completed_at          DateTime?             @db.Timestamptz(6)
  createdAt             DateTime              @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @map("updated_at") @db.Timestamptz(6)
  educational_resources educational_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@unique([utilisateur_id, resource_id], map: "educational_progress_utilisateur_id_resource_id")
}

// Phase 2, module 3/3 — Price-Index (analyse concurrentielle #8, transparence
// marché). Contrairement aux modules précédents, ce module ne possède AUCUNE
// table : il agrège en lecture seule des données encore entièrement
// possédées par Sequelize (produits/commandes/details_commandes). Ces trois
// modèles ne déclarent donc que les colonnes réellement lues par
// PriceIndexService — jamais d'écriture Prisma ici, Sequelize reste seul
// propriétaire du schéma complet de ces tables (voir aussi
// backend/src/product/models/product.model.js, backend/src/order/models/
// {order,orderItem}.model.js).
model produits {
  id                 String               @id @db.Uuid
  nom_produit        String               @db.VarChar(150)
  prix_unitaire      Decimal              @db.Decimal(15, 2)
  image_url          String?
  categorie_id       String?              @db.Uuid
  boutique_id        String?              @db.Uuid
  stock_quantite     Int?                 @default(0)
  categories         categories?          @relation(fields: [categorie_id], references: [id])
  boutiques          boutiques?           @relation(fields: [boutique_id], references: [id])
  details_commandes  details_commandes[]
  stocks_partenaires stocks_partenaires[]
  reviews            reviews[]
  seuils_alerte      seuils_alerte[]
  questions_produits questions_produits[]
}

// Modélisation partielle (id + proprietaire_id seulement) — nécessaire à la
// vérification de propriété d'un produit par partner-stock.service.ts
// (assertOwnsProduct), jamais un module possédé par Prisma : Sequelize reste
// seul propriétaire du schéma complet de "boutiques" (20+ colonnes, voir
// backend/src/store/models/store.model.js).
// temps_reponse : colonne texte d'affichage ("< 2h"), jamais une durée
// numérique — vendor-scorecard.service.ts#getScorecard reproduit fidèlement
// la coercition JS de l'original (Number('< 2h') = NaN, donc le sous-score
// réactivité vaut NaN -> `null` une fois sérialisé en JSON) plutôt que de
// corriger un comportement déjà en production (voir store.model.js, jamais
// alimentée par une vraie mesure de délai de réponse à ce jour).
model boutiques {
  id              String     @id @db.Uuid
  nom_boutique    String     @db.VarChar(100)
  proprietaire_id String?    @db.Uuid
  temps_reponse   String?    @db.VarChar(50)
  createdAt       DateTime   @map("created_at") @db.Timestamptz(6)
  produits        produits[]
  factures        factures[]
  coupons         coupons[]
}

model commandes {
  id                String              @id @db.Uuid
  statut            String?             @db.VarChar(32)
  utilisateur_id    String?             @db.Uuid
  details_commandes details_commandes[]
  factures          factures[]
}

model details_commandes {
  id                  String     @id @db.Uuid
  quantite            Int
  prix_unitaire_achat Decimal    @db.Decimal(15, 2)
  statut              String?    @db.VarChar(32)
  createdAt            DateTime  @map("created_at") @db.Timestamptz(6)
  commande_id          String?   @db.Uuid
  produit_id           String?   @db.Uuid
  fournisseur_id        String?   @db.Uuid
  commandes            commandes? @relation(fields: [commande_id], references: [id])
  produits             produits?  @relation(fields: [produit_id], references: [id])
}

// Phase 2+ — Scorecard fournisseur (analyse concurrentielle #6). Modélisation
// partielle : seuls commande_id/defenseur_id sont lus (vendorScorecard.
// service.ts#getScorecard compte les commandes distinctes en litige pour un
// vendeur donné) — Sequelize reste seul propriétaire du schéma complet
// (backend/src/dispute/models/litige.model.js), lecture seule ici.
model litiges {
  id           String @id @db.Uuid
  commande_id  String @db.Uuid
  defenseur_id String @db.Uuid
}

// Phase 2+ — idem, pour la note moyenne d'un vendeur (jointure INNER sur
// produits.boutique_id, réplique le `required: true` Sequelize original —
// voir backend/src/review/models/review.model.js pour le schéma complet).
model reviews {
  id         String    @id @db.Uuid
  note       Int
  produit_id String?   @db.Uuid
  produits   produits? @relation(fields: [produit_id], references: [id])
}

// Modélisation partielle (id, nom_complet, email) — nécessaire à
// invoice.service.ts pour afficher l'identité de l'acheteur sur une facture.
// telephone est délibérément absent : User.model.js le chiffre au repos
// (AES-256-GCM, hooks Sequelize beforeSave/afterFind) — une lecture directe
// via Prisma renverrait le texte chiffré brut, pas un numéro utilisable.
// Non requis légalement sur la facture (seul le NIF l'est, déjà porté par
// factures.acheteur_nif) : simplement omis plutôt que mal affiché. Jamais un
// module possédé par Prisma (auth/user restent Sequelize jusqu'à la toute
// fin de la migration, voir le plan) : lecture seule.
model utilisateurs {
  id               String               @id @db.Uuid
  nom_complet      String               @db.VarChar(255)
  email            String               @db.VarChar(255)
  role             String?              @db.VarChar(20)
  factures         factures[]
  audit_logs       audit_logs[]
  questions_posees questions_produits[] @relation("QuestionAuteur")
  reponses_donnees questions_produits[] @relation("QuestionRepondant")
}

// Phase 2+ — Certifications fournisseurs (analyse concurrentielle #5, cahier
// des charges 6.5). Aucune association entrante depuis une autre table
// (vérifié dans backend/src/models/index.js : seule une FK sortante vers
// User, qui reste Sequelize jusqu'à la toute fin de la migration) — modèle
// entièrement supprimable côté Sequelize, comme Webinar/Education.
// review() déclenche un effet de bord sur boutiques.is_verified/
// niveau_verification (encore Sequelize) via le pont interne
// (POST /internal/verify-store), jamais une écriture Prisma directe sur
// une table dont Sequelize reste par ailleurs seul propriétaire.
model certifications {
  id                String    @id @db.Uuid
  fournisseur_id    String    @db.Uuid
  type              String    @db.VarChar(100)
  document_url      String    @db.VarChar(255)
  statut            String?   @default("en_attente") @db.VarChar(20)
  commentaire_admin String?
  date_expiration   DateTime? @db.Date
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(6)
}

// Phase 2+ — Stock détenu par un tiers pour un produit (cahier des charges
// 2.5). Table feuille : aucune association entrante depuis une autre table
// (vérifié dans backend/src/models/index.js), modèle Sequelize entièrement
// supprimable comme Webinar/Education/Certification. La vérification de
// propriété (assertOwnsProduct côté service) traverse produits -> boutiques,
// toutes deux encore possédées par Sequelize — lecture seule, jamais
// d'écriture Prisma sur ces deux tables.
model stocks_partenaires {
  id                 String                             @id @db.Uuid
  produit_id         String                             @db.Uuid
  partenaire_nom     String                             @db.VarChar(150)
  partenaire_contact String?                            @db.VarChar(150)
  type_stock         enum_stocks_partenaires_type_stock @default(entrepot_tiers)
  quantite           Int                                @default(0)
  localisation       String?                            @db.VarChar(200)
  notes              String?
  derniere_synchro   DateTime?                          @db.Timestamptz(6)
  createdAt          DateTime                           @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                           @map("updated_at") @db.Timestamptz(6)
  produits           produits                           @relation(fields: [produit_id], references: [id], onDelete: Cascade)
}

enum enum_stocks_partenaires_type_stock {
  consigne
  entrepot_tiers
  dropshipping
}

// Phase 2+ — Facturation légale conforme CGI Guinée (analyse concurrentielle
// #3) et export SYSCOHADA (analyse concurrentielle #9). Aucune association
// entrante depuis une autre table Sequelize (vérifié dans
// backend/src/models/index.js) — les deux modèles sont entièrement
// supprimables côté Sequelize, comme Webinar/Education/Certification/
// Partner-Stock. Lit produits/commandes/details_commandes/boutiques/
// utilisateurs, toutes encore possédées par Sequelize (lecture seule,
// jamais d'écriture Prisma sur ces tables).
model factures {
  id             String       @id @db.Uuid
  numero         String       @unique @db.VarChar(30)
  commande_id    String       @db.Uuid
  boutique_id    String       @db.Uuid
  utilisateur_id String       @db.Uuid
  acheteur_nif   String?      @db.VarChar(50)
  montant_ht     Decimal      @db.Decimal(15, 2)
  taux_tva       Decimal      @default(18.00) @db.Decimal(5, 2)
  montant_tva    Decimal      @db.Decimal(15, 2)
  montant_ttc    Decimal      @db.Decimal(15, 2)
  date_emission  DateTime     @default(now()) @db.Timestamptz(6)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(6)
  commandes      commandes    @relation(fields: [commande_id], references: [id], onDelete: Cascade)
  boutiques      boutiques    @relation(fields: [boutique_id], references: [id], onDelete: Cascade)
  utilisateurs   utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@unique([commande_id, boutique_id], map: "factures_commande_boutique_unique")
}

// Ligne unique verrouillée à chaque émission de facture (numérotation
// séquentielle sans trou, exigée par le CGI Guinée) — voir
// invoice.service.ts#nextInvoiceNumber pour la stratégie d'incrémentation
// atomique (UPDATE ... SET x = x + 1, Postgres sérialise nativement les
// écritures concurrentes sur une même ligne, pas besoin d'un SELECT FOR
// UPDATE explicite comme le faisait la version Sequelize).
model compteurs_facture {
  id             Int @id @default(autoincrement())
  dernier_numero Int @default(0)
}

// Phase 2+ — Journal d'audit (analyse concurrentielle sécurité). Contrairement
// à Certification/Partner-Stock/Invoice, la table "audit_logs" N'EST PAS
// entièrement supprimable côté Sequelize : elle reste alimentée en écriture
// par des dizaines de modules encore Sequelize (middlewares/
// auditMiddleware.js, utils/logger.js, services/userDeletionService.js) —
// seule l'API de LECTURE (liste/filtre/export admin) bascule vers
// NestJS+Prisma ici. Jamais d'écriture Prisma sur cette table, même après le
// cutover (voir audit-log.service.ts) : même principe de mirroir en lecture
// seule que litiges/reviews pour vendor-scorecard, mais appliqué cette fois
// au module propriétaire de l'API plutôt qu'à un lecteur tiers.
model audit_logs {
  id                String        @id @db.Uuid
  action            String        @db.VarChar(100)
  description       String?
  table_affectee    String?       @db.VarChar(50)
  id_enregistrement String?       @db.Uuid
  adresse_ip        String?       @db.VarChar(45)
  agent_utilisateur String?
  niveau_alerte     String?       @default("info") @db.VarChar(10)
  utilisateur_id    String?       @db.Uuid
  createdAt         DateTime      @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @map("updated_at") @db.Timestamptz(6)
  utilisateurs      utilisateurs? @relation(fields: [utilisateur_id], references: [id])
}

// Phase 2+ — Seuils d'alerte dynamiques (cahier des charges 3.6). À la
// différence des modules précédents, la table "seuils_alerte" reste AUSSI
// écrite côté Sequelize : backend/src/cron/alertThresholdCron.js appelle
// toutes les 30 min alertThreshold.service.js#evaluateAll, qui met à jour
// dernier_declenchement et crée des Notification (table non migrée) — cette
// fonction et le modèle Sequelize sont donc conservés intentionnellement.
// NestJS/Prisma ne possède que la surface HTTP utilisateur (créer/activer/
// désactiver/supprimer un seuil) ; les deux écrivent sur la même table,
// jamais en conflit (le cron ne touche que actif=true et dernier_declenchement,
// l'API HTTP ne touche jamais cette colonne).
model seuils_alerte {
  id                    String    @id @db.Uuid
  utilisateur_id        String    @db.Uuid
  produit_id            String    @db.Uuid
  type                  String    @db.VarChar(20)
  operateur             String    @default("inferieur_egal") @db.VarChar(20)
  valeur_seuil          Decimal   @db.Decimal(15, 2)
  actif                 Boolean   @default(true)
  dernier_declenchement DateTime?
  createdAt             DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(6)
  produits              produits  @relation(fields: [produit_id], references: [id], onDelete: Cascade)

  @@unique([utilisateur_id, produit_id, type], map: "seuils_alerte_user_produit_type_unique")
}

// Phase 2+ — Q&A produit public, style Amazon (cahier des charges). Aucune
// association entrante depuis une autre table Sequelize (vérifié dans
// backend/src/models/index.js) — modèle entièrement supprimable côté
// Sequelize, comme Certification/Partner-Stock/Invoice. Notifications temps
// réel (nouvelle question / réponse publiée) déléguées au pont interne
// (internalBridgeService.createNotification, voir internal-bridge.service.ts)
// — Notification reste une table Sequelize, jamais d'écriture Prisma dessus.
model questions_produits {
  id             String        @id @db.Uuid
  produit_id     String        @db.Uuid
  utilisateur_id String        @db.Uuid
  question       String
  reponse        String?
  repondu_par    String?       @db.Uuid
  repondu_at     DateTime?
  utile_count    Int?          @default(0)
  visible        Boolean?      @default(true)
  createdAt      DateTime      @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @map("updated_at") @db.Timestamptz(6)
  produits       produits      @relation(fields: [produit_id], references: [id], onDelete: Cascade)
  auteur         utilisateurs  @relation("QuestionAuteur", fields: [utilisateur_id], references: [id], onDelete: Cascade)
  repondant      utilisateurs? @relation("QuestionRepondant", fields: [repondu_par], references: [id])
}

// Phase 2+ — Codes promo. À la différence des modules purement HTTP déjà
// migrés, "coupons"/"coupon_usages" restent AUSSI écrites côté Sequelize :
// order.service.js (module `order`, pas encore migré) appelle directement
// coupon.service.js#validate/applyDiscountToItems/recordUsage à l'intérieur
// de sa propre transaction Sequelize (verrou SELECT ... FOR UPDATE sur le
// coupon pendant la création de commande) — conservées intentionnellement
// côté Sequelize, jamais dupliquées ici. NestJS/Prisma ne possède que la
// surface HTTP admin/fournisseur (créer/lister/activer-désactiver/stats) et
// l'aperçu panier en lecture seule (validateCart, sans verrou : ne consomme
// jamais l'usage, donc aucun risque de race avec la vraie création de
// commande). Les deux écrivent sur les mêmes tables sans jamais se
// chevaucher : seul recordUsage (Sequelize) touche usage_count/coupon_usages.
model coupons {
  id                        String          @id @db.Uuid
  code                      String          @unique @db.VarChar(30)
  createur_id               String          @db.Uuid
  boutique_id               String?         @db.Uuid
  type                      String          @default("percentage") @db.VarChar(15)
  valeur                    Decimal         @db.Decimal(15, 2)
  montant_min               Decimal?        @db.Decimal(15, 2)
  date_debut                DateTime?
  date_fin                  DateTime?
  usage_max                 Int?
  usage_max_par_utilisateur Int?            @default(1)
  usage_count                Int?           @default(0)
  actif                      Boolean?       @default(true)
  createdAt                  DateTime       @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime       @map("updated_at") @db.Timestamptz(6)
  boutiques                  boutiques?     @relation(fields: [boutique_id], references: [id])
  coupon_usages               coupon_usages[]
}

model coupon_usages {
  id                String   @id @db.Uuid
  coupon_id         String   @db.Uuid
  utilisateur_id    String   @db.Uuid
  commande_id       String?  @db.Uuid
  montant_reduction Decimal  @db.Decimal(15, 2)
  createdAt         DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(6)
  coupons           coupons  @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
}
