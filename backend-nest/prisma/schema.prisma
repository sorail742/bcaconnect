// Schéma Prisma — ne modélise que les tables déjà reprises par un module
// NestJS migré (cf. plan de migration progressive, cahier des charges
// "backend totalement NestJS"). Toute autre table reste possédée par
// Sequelize côté backend/ tant que son module n'a pas basculé : ne pas
// ajouter de modèle ici sans faire le cutover correspondant dans
// backend/src/app.js + supprimer le modèle Sequelize équivalent.
//
// Modèles obtenus par introspection réelle (`prisma db pull`) de la base
// partagée avec Sequelize — jamais recopiés à la main depuis les fichiers
// backend/src/**/models/*.model.js.
//
// created_at/updated_at sont mappés en createdAt/updatedAt (@map) : c'est
// le nom que Sequelize expose réellement côté JSON (timestamps automatiques
// non affectés par `underscored: true`, qui ne renomme que la colonne SQL,
// jamais l'attribut JS) — sans ce mapping, tout consommateur frontend qui
// lit `.createdAt` recevrait `undefined`.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Module pilote (Phase 1) — table "webinaires", zéro association entrante
// ou sortante avec une autre table (vérifié dans backend/src/models/index.js
// avant de choisir ce module comme pilote).
model webinaires {
  id                 String                  @id @db.Uuid
  titre              String                  @db.VarChar(255)
  description        String
  date_heure         DateTime                @db.Timestamptz(6)
  intervenant        String                  @db.VarChar(255)
  categorie          String?                 @db.VarChar(255)
  statut             enum_webinaires_statut? @default(a_venir)
  participants_count Int?                    @default(0)
  lien_rejoindre     String?                 @db.VarChar(255)
  video_url          String?                 @db.VarChar(255)
  createdAt          DateTime                @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @map("updated_at") @db.Timestamptz(6)
}

enum enum_webinaires_statut {
  a_venir
  en_direct
  termine
}

// Phase 2, module 1/3 — table "categories". Référencée par des tables
// encore côté Sequelize (produits.categorie_id, demandes_devis.categorie_id,
// et le self-lien parent_id) — vérifié directement en base (pg_constraint) :
// les 3 contraintes sont ON DELETE SET NULL, jamais RESTRICT. Supprimer une
// catégorie qui a encore des produits/sous-catégories/demandes de devis
// rattachés réussit toujours ; ces lignes se retrouvent juste avec un
// categorie_id/parent_id à NULL. category.service.ts garde malgré tout une
// interception générique de P2003 (bonne pratique défensive sur un endpoint
// de suppression), mais elle ne devrait jamais se déclencher pour ce cas
// précis.
model categories {
  id              String       @id @db.Uuid
  nom_categorie   String       @unique @db.VarChar(50)
  description     String?
  parent_id       String?      @db.Uuid
  statut          String?      @default("actif") @db.VarChar(20)
  image_url       String?      @db.VarChar(255)
  createdAt       DateTime     @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @map("updated_at") @db.Timestamptz(6)
  parent          categories?  @relation("sousCategories", fields: [parent_id], references: [id])
  sous_categories categories[] @relation("sousCategories")
  produits        produits[]
}

// Phase 2, module 2/3 — "BCA Academy" (educational_resources/quizzes/
// progress, cahier des charges 3.14). Seule association entrante depuis un
// module encore Sequelize : educational_progress.utilisateur_id -> User
// (onDelete: Cascade) — l'alias Sequelize `progression_academy` déclaré
// dans models/index.js n'est utilisé par aucun `include` dans le reste du
// code (vérifié par recherche), donc aucun risque de lecture cassée côté
// Express à retirer ce modèle. educational_quizzes/progress référencent
// educational_resources en Cascade également (supprimer une ressource
// supprime son quiz et toute la progression liée — comportement Postgres
// réel, pas une simplification introduite ici).
model educational_resources {
  id                    String                                     @id @db.Uuid
  titre                 String                                     @db.VarChar(255)
  description           String
  type_contenu          enum_educational_resources_type_contenu?   @default(article)
  url_contenu           String                                     @db.VarChar(500)
  audience_cible        enum_educational_resources_audience_cible? @default(tous)
  tag                   String?                                    @db.VarChar(100)
  createdAt             DateTime                                   @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                                   @map("updated_at") @db.Timestamptz(6)
  educational_quizzes   educational_quizzes?
  educational_progress  educational_progress[]
}

enum enum_educational_resources_type_contenu {
  video
  article
  guide
  pdf
}

enum enum_educational_resources_audience_cible {
  tous
  fournisseurs
  clients
  transporteurs
}

model educational_quizzes {
  id                    String                @id @db.Uuid
  resource_id           String                @unique @db.Uuid
  questions             Json                  @default("[]") @db.Json
  passing_score         Int?                  @default(60)
  createdAt             DateTime              @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @map("updated_at") @db.Timestamptz(6)
  educational_resources educational_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)
}

model educational_progress {
  id                    String                @id @db.Uuid
  utilisateur_id        String                @db.Uuid
  resource_id           String                @db.Uuid
  statut                String?               @default("vu") @db.VarChar(20)
  quiz_score            Int?
  tentatives            Int?                  @default(0)
  completed_at          DateTime?             @db.Timestamptz(6)
  createdAt             DateTime              @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @map("updated_at") @db.Timestamptz(6)
  educational_resources educational_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@unique([utilisateur_id, resource_id], map: "educational_progress_utilisateur_id_resource_id")
}

// Phase 2, module 3/3 — Price-Index (analyse concurrentielle #8, transparence
// marché). Contrairement aux modules précédents, ce module ne possède AUCUNE
// table : il agrège en lecture seule des données encore entièrement
// possédées par Sequelize (produits/commandes/details_commandes). Ces trois
// modèles ne déclarent donc que les colonnes réellement lues par
// PriceIndexService — jamais d'écriture Prisma ici, Sequelize reste seul
// propriétaire du schéma complet de ces tables (voir aussi
// backend/src/product/models/product.model.js, backend/src/order/models/
// {order,orderItem}.model.js).
model produits {
  id                 String               @id @db.Uuid
  nom_produit        String               @db.VarChar(150)
  categorie_id       String?              @db.Uuid
  boutique_id        String?              @db.Uuid
  stock_quantite     Int?                 @default(0)
  categories         categories?          @relation(fields: [categorie_id], references: [id])
  boutiques          boutiques?           @relation(fields: [boutique_id], references: [id])
  details_commandes  details_commandes[]
  stocks_partenaires stocks_partenaires[]
}

// Modélisation partielle (id + proprietaire_id seulement) — nécessaire à la
// vérification de propriété d'un produit par partner-stock.service.ts
// (assertOwnsProduct), jamais un module possédé par Prisma : Sequelize reste
// seul propriétaire du schéma complet de "boutiques" (20+ colonnes, voir
// backend/src/store/models/store.model.js).
model boutiques {
  id              String     @id @db.Uuid
  proprietaire_id String?    @db.Uuid
  produits        produits[]
}

model commandes {
  id                String              @id @db.Uuid
  statut            String?             @db.VarChar(32)
  details_commandes details_commandes[]
}

model details_commandes {
  id                  String     @id @db.Uuid
  quantite            Int
  prix_unitaire_achat Decimal    @db.Decimal(15, 2)
  createdAt            DateTime  @map("created_at") @db.Timestamptz(6)
  commande_id          String?   @db.Uuid
  produit_id           String?   @db.Uuid
  commandes            commandes? @relation(fields: [commande_id], references: [id])
  produits             produits?  @relation(fields: [produit_id], references: [id])
}

// Phase 2+ — Certifications fournisseurs (analyse concurrentielle #5, cahier
// des charges 6.5). Aucune association entrante depuis une autre table
// (vérifié dans backend/src/models/index.js : seule une FK sortante vers
// User, qui reste Sequelize jusqu'à la toute fin de la migration) — modèle
// entièrement supprimable côté Sequelize, comme Webinar/Education.
// review() déclenche un effet de bord sur boutiques.is_verified/
// niveau_verification (encore Sequelize) via le pont interne
// (POST /internal/verify-store), jamais une écriture Prisma directe sur
// une table dont Sequelize reste par ailleurs seul propriétaire.
model certifications {
  id                String    @id @db.Uuid
  fournisseur_id    String    @db.Uuid
  type              String    @db.VarChar(100)
  document_url      String    @db.VarChar(255)
  statut            String?   @default("en_attente") @db.VarChar(20)
  commentaire_admin String?
  date_expiration   DateTime? @db.Date
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(6)
}

// Phase 2+ — Stock détenu par un tiers pour un produit (cahier des charges
// 2.5). Table feuille : aucune association entrante depuis une autre table
// (vérifié dans backend/src/models/index.js), modèle Sequelize entièrement
// supprimable comme Webinar/Education/Certification. La vérification de
// propriété (assertOwnsProduct côté service) traverse produits -> boutiques,
// toutes deux encore possédées par Sequelize — lecture seule, jamais
// d'écriture Prisma sur ces deux tables.
model stocks_partenaires {
  id                 String                             @id @db.Uuid
  produit_id         String                             @db.Uuid
  partenaire_nom     String                             @db.VarChar(150)
  partenaire_contact String?                            @db.VarChar(150)
  type_stock         enum_stocks_partenaires_type_stock @default(entrepot_tiers)
  quantite           Int                                @default(0)
  localisation       String?                            @db.VarChar(200)
  notes              String?
  derniere_synchro   DateTime?                          @db.Timestamptz(6)
  createdAt          DateTime                           @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                           @map("updated_at") @db.Timestamptz(6)
  produits           produits                           @relation(fields: [produit_id], references: [id], onDelete: Cascade)
}

enum enum_stocks_partenaires_type_stock {
  consigne
  entrepot_tiers
  dropshipping
}
