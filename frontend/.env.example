# Frontend — variables d'environnement (copier vers .env.local)
# cp .env.example .env.local
#
# Ports standard équipe :
#   Frontend (Vite) : 3002
#   Backend (API)   : 5000

VITE_BACKEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:3002

# Google OAuth — Console Google Cloud → Identifiants → Client OAuth Web
# Origines autorisées : http://localhost:3002
# Copier le même ID dans backend/.env → GOOGLE_CLIENT_ID (ce n'est pas un
# secret : le Client ID est visible côté navigateur par design, seul le
# backend a besoin d'une valeur "secrète" — et même celle-ci n'est
# aujourd'hui pas utilisée par le code actuel).
VITE_GOOGLE_CLIENT_ID=votre_client_id_google.apps.googleusercontent.com
